// Prisma Schema for All Gujarat Vankar Samaj Matrimony

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())

  @@map("system_health")
}

enum Role {
  USER
  SUPER_ADMIN
  ADMIN
  VERIFICATION_ADMIN
  CONTENT_ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

model User {
  id           String              @id @default(uuid())
  email        String?             @unique
  phone        String?             @unique
  name         String?
  gender       Gender?
  passwordHash String              @map("password_hash")
  role         Role                @default(USER)
  status       Status              @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  profile      MatrimonialProfile?

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum ProfileStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model MatrimonialProfile {
  id               String        @id @default(uuid())
  userId           String        @unique @map("user_id")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String        @map("first_name")
  lastName         String        @map("last_name")
  dateOfBirth      DateTime      @map("date_of_birth")
  gender           Gender
  maritalStatus    MaritalStatus @map("marital_status")
  religion         String?
  caste            String?
  subcaste         String?
  nativePlace      String?       @map("native_place")
  city             String?
  state            String?
  country          String?
  education        String?
  occupation       String?
  organizationName String?       @map("organization_name")
  designation      String?
  about            String?
  photoUrl         String?       @map("photo_url")

  stateId    String?   @map("state_id")
  districtId String?   @map("district_id")
  talukaId   String?   @map("taluka_id")
  parganaId  String?   @map("pargana_id")
  villageId  String?   @map("village_id")
  stateRef   State?    @relation(fields: [stateId], references: [id], onDelete: SetNull)
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  taluka     Taluka?   @relation(fields: [talukaId], references: [id], onDelete: SetNull)
  pargana    Pargana?  @relation(fields: [parganaId], references: [id], onDelete: SetNull)
  village    Village?  @relation(fields: [villageId], references: [id], onDelete: SetNull)

  status               ProfileStatus         @default(APPROVED)
  isVerified           Boolean               @default(false) @map("is_verified")
  isFeatured           Boolean               @default(false) @map("is_featured")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  governmentEmployment GovernmentEmployment?
  verificationRequests VerificationRequest[]

  @@map("matrimonial_profiles")
}

model Shortlist {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  targetProfileId String   @map("target_profile_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, targetProfileId])
  @@map("shortlists")
}


model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model State {
  id           String               @id @default(uuid())
  name         String
  gujaratiName String?              @map("gujarati_name")
  code         String               @unique
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  districts    District[]
  profiles     MatrimonialProfile[]

  @@map("states")
}

model District {
  id                  String               @id @default(uuid())
  stateId             String               @map("state_id")
  state               State                @relation(fields: [stateId], references: [id], onDelete: Restrict)
  name                String
  gujaratiName        String?              @map("gujarati_name")
  code                String?
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  talukas             Taluka[]
  profiles            MatrimonialProfile[]
  samajServicePersons SamajServicePerson[]

  @@index([stateId])
  @@map("districts")
}

model Taluka {
  id                  String               @id @default(uuid())
  districtId          String               @map("district_id")
  district            District             @relation(fields: [districtId], references: [id], onDelete: Restrict)
  name                String
  gujaratiName        String?              @map("gujarati_name")
  code                String?
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  parganas            ParganaTaluka[]
  villages            Village[]
  profiles            MatrimonialProfile[]
  samajServicePersons SamajServicePerson[]

  @@index([districtId])
  @@map("talukas")
}

model Pargana {
  id             String               @id @default(uuid())
  name           String
  gujaratiName   String?              @map("gujarati_name")
  code           String?              @unique
  description    String?
  villageCount   String?              @map("village_count")
  districtRegion String?              @map("district_region")
  leaderName     String?              @map("leader_name")
  contactPhone   String?              @map("contact_phone")
  manualCount    Int?                 @map("manual_count")
  totalCount     Int                  @default(0) @map("total_count")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  talukas        ParganaTaluka[]
  villages       Village[]
  profiles       MatrimonialProfile[]

  @@map("parganas")
}

model ParganaTaluka {
  parganaId String  @map("pargana_id")
  talukaId  String  @map("taluka_id")
  pargana   Pargana @relation(fields: [parganaId], references: [id], onDelete: Cascade)
  taluka    Taluka  @relation(fields: [talukaId], references: [id], onDelete: Cascade)

  @@id([parganaId, talukaId])
  @@map("pargana_talukas")
}

model Village {
  id                  String               @id @default(uuid())
  parganaId           String?              @map("pargana_id")
  pargana             Pargana?             @relation(fields: [parganaId], references: [id], onDelete: SetNull)
  talukaId            String?              @map("taluka_id")
  taluka              Taluka?              @relation(fields: [talukaId], references: [id], onDelete: SetNull)
  name                String
  gujaratiName        String?              @map("gujarati_name")
  code                String?
  pincode             String?
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  profiles            MatrimonialProfile[]
  samajServicePersons SamajServicePerson[]

  @@index([parganaId])
  @@index([talukaId])
  @@map("villages")
}

model VerificationRequest {
  id              String             @id @default(uuid())
  profileId       String             @map("profile_id")
  profile         MatrimonialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  documentType    String             @map("document_type")
  documentUrl     String             @map("document_url")
  status          VerificationStatus @default(PENDING)
  rejectionReason String?            @map("rejection_reason")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@map("verification_requests")
}

model MatchInterest {
  id                String         @id @default(uuid())
  senderProfileId   String         @map("sender_profile_id")
  receiverProfileId String         @map("receiver_profile_id")
  status            InterestStatus @default(PENDING)
  createdAt         DateTime       @default(now()) @map("created_at")

  @@map("match_interests")
}

model Report {
  id              String       @id @default(uuid())
  reporterUserId  String       @map("reporter_user_id")
  targetProfileId String       @map("target_profile_id")
  reason          String
  details         String?
  status          ReportStatus @default(OPEN)
  createdAt       DateTime     @default(now()) @map("created_at")

  @@map("reports")
}

model SuccessStory {
  id          String   @id @default(uuid())
  brideName   String   @map("bride_name")
  groomName   String   @map("groom_name")
  weddingDate String?  @map("wedding_date")
  story       String
  imageUrl    String?  @map("image_url")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("success_stories")
}

model SamajService {
  id            String               @id @default(uuid())
  title         String
  slug          String               @unique
  category      String               @default("General")
  icon          String               @default("🤝")
  contactPhone  String?              @map("contact_phone")
  contactPerson String?              @map("contact_person")
  description   String?
  sortOrder     Int                  @default(0) @map("sort_order")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  persons       SamajServicePerson[]

  @@map("samaj_services")
}

model SamajServicePerson {
  id           String       @id @default(uuid())
  serviceId    String       @map("service_id")
  service      SamajService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name         String
  gujaratiName String?      @map("gujarati_name")
  photoUrl     String?      @map("photo_url")
  phone        String
  address      String?
  city         String?
  description  String?
  experience   String?
  districtId   String?      @map("district_id")
  talukaId     String?      @map("taluka_id")
  villageId    String?      @map("village_id")
  district     District?    @relation(fields: [districtId], references: [id], onDelete: SetNull)
  taluka       Taluka?      @relation(fields: [talukaId], references: [id], onDelete: SetNull)
  village      Village?     @relation(fields: [villageId], references: [id], onDelete: SetNull)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([serviceId])
  @@map("samaj_service_persons")
}

enum GovtEmploymentType {
  CENTRAL_GOVT
  STATE_GOVT
  PSU
  SEMI_GOVT
  DEFENSE
  BANKING
  RAILWAYS
}

enum GovtVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model GovtDepartment {
  id           String                 @id @default(uuid())
  name         String
  gujaratiName String?                @map("gujarati_name")
  code         String?                @unique
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  designations GovtDesignation[]
  employments  GovernmentEmployment[]

  @@map("govt_departments")
}

model GovtDesignation {
  id           String                 @id @default(uuid())
  departmentId String                 @map("department_id")
  department   GovtDepartment         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  gujaratiName String?                @map("gujarati_name")
  code         String?
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  employments  GovernmentEmployment[]

  @@index([departmentId])
  @@map("govt_designations")
}

model GovernmentEmployment {
  id                      String                             @id @default(uuid())
  profileId               String                             @unique @map("profile_id")
  profile                 MatrimonialProfile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  employmentType          GovtEmploymentType                 @default(STATE_GOVT) @map("employment_type")
  departmentId            String?                            @map("department_id")
  department              GovtDepartment?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId           String?                            @map("designation_id")
  designation             GovtDesignation?                   @relation(fields: [designationId], references: [id], onDelete: SetNull)
  officeLocation          String?                            @map("office_location")
  joiningYear             Int?                               @map("joining_year")
  verificationStatus      GovtVerificationStatus             @default(PENDING) @map("verification_status")
  verificationSubmittedAt DateTime?                          @map("verification_submitted_at")
  verifiedAt              DateTime?                          @map("verified_at")
  verifiedBy              String?                            @map("verified_by")
  rejectionReason         String?                            @map("rejection_reason")
  isFeatured              Boolean                            @default(false) @map("is_featured")
  isActive                Boolean                            @default(true) @map("is_active")
  createdAt               DateTime                           @default(now()) @map("created_at")
  updatedAt               DateTime                           @updatedAt @map("updated_at")
  verifications           GovernmentEmploymentVerification[]

  @@index([departmentId])
  @@index([designationId])
  @@map("government_employments")
}

model GovernmentEmploymentVerification {
  id              String                 @id @default(uuid())
  employmentId    String                 @map("employment_id")
  employment      GovernmentEmployment   @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  documentType    String                 @default("GOVT_ID_CARD") @map("document_type")
  documentUrl     String                 @map("document_url")
  status          GovtVerificationStatus @default(PENDING)
  reviewedBy      String?                @map("reviewed_by")
  reviewedAt      DateTime?              @map("reviewed_at")
  rejectionReason String?                @map("rejection_reason")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@index([employmentId])
  @@map("government_employment_verifications")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("admin_audit_logs")
}

enum AdPlacement {
  HOME_BANNER
  DIRECTORY_BANNER
  POPUP
}

model Advertisement {
  id        String      @id @default(uuid())
  title     String
  imageUrl  String      @map("image_url")
  targetUrl String?     @map("target_url")
  placement AdPlacement @default(HOME_BANNER)
  isActive  Boolean     @default(true) @map("is_active")
  startAt   DateTime?   @map("start_at")
  endAt     DateTime?   @map("end_at")
  sortOrder Int         @default(0) @map("sort_order")
  createdBy String?     @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("advertisements")
}
