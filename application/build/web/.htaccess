RewriteEngine On

# Correct MIME Types for WebAssembly, JS, and JSON
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/javascript .js .mjs
    AddType application/json .json
</IfModule>

# Cache-Control headers for static assets & performance
<IfModule mod_headers.c>
    # Dynamic HTML & JSON: never cache so updates are immediate
    <FilesMatch "\.(html|htm|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Static Immutable Next.js JavaScript chunks & CSS
    <FilesMatch "\.(js|mjs|css)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
    </FilesMatch>

    # Images, Fonts, Icons, and Media
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot|mp4|webm)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# Allow direct file access for existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Return real 404 for missing static assets (js, css, images) so they never serve index.html
# Exclude /uploads/ so media requests can be served by api_proxy.php or symlinked directory
RewriteCond %{REQUEST_URI} !^/uploads/ [NC]
RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map)$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [R=404,L]

# Route API and dynamic backend endpoints to api_proxy.php
RewriteRule ^api/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^verifications/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^advertisements/?(.*)$ api_proxy.php [QSA,L]
RewriteRule ^auth/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^profiles/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^storage/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^interests/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^chat/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^notifications/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^master-data/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^parganas/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^locations/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^education/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^government-employees/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^samaj-services/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^samaj-super-stars/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^samaj-ratna/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^pavan-prernadata/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^shortlists/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^reports/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^settings/(.*)$ api_proxy.php [QSA,L]
RewriteRule ^health/?(.*)$ api_proxy.php [QSA,L]

# Route /uploads/ to api_proxy.php as fallback
RewriteRule ^uploads/(.*)$ api_proxy.php [QSA,L]

# Privacy Policy & Account Deletion URLs for Google Play Console compliance
RewriteRule ^privacy-policy/?$ privacy-policy.html [L]
RewriteRule ^privacy/?$ privacy-policy.html [L]
RewriteRule ^delete-account/?$ delete-account.html [L]
RewriteRule ^account-deletion/?$ delete-account.html [L]
RewriteRule ^delete-data/?$ delete-account.html [L]

# Normal Flutter/SPA routing (fallback to index.html for non-files)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]
