# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vankar_matrimony

# Prisma Database URL (Matches the postgres container in docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/vankar_matrimony?schema=public"

# NestJS Application Configuration
PORT=3000

# Authentication Secrets
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
